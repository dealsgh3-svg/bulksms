# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME="TextFlow Pro"
APP_TAGLINE="Enterprise SMS Made Simple"

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms_saas
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/sms_saas?pgbypass=true

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TextFlow Pro <noreply@textflowpro.com>"

# ===========================================
# SMS PROVIDERS
# ===========================================
# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Termii
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=textflow

# Infobip
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=https://api.infobip.com

# ===========================================
# PAYMENT GATEWAYS
# ===========================================
# Kora Pay (Primary - Default)
KORA_SECRET_KEY=sk_live_your-kora-secret-key
KORA_PUBLIC_KEY=pk_live_your-kora-public-key
KORA_WEBHOOK_SECRET=your-kora-webhook-secret
KORA_BASE_URL=https://api.korapay.com

# Paystack (Secondary)
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
PAYSTACK_BASE_URL=https://api.paystack.co

# ===========================================
# FILE STORAGE
# ===========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=1000

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# ENCRYPTION
# ===========================================
ENCRYPTION_KEY=your-32-character-encryption-key
